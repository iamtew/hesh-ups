<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="hesh-ups"
    Manufacturer="TEW020"
    Version="$(var.Version)"
    UpgradeCode="8f3c2a91-6b4e-4d17-9c08-e2a1b7f04d63"
    Scope="perUser"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of hesh-ups is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="hesh-ups" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="App" Title="hesh-ups" Description="hesh-ups application files" Level="1" AllowAbsent="no" Display="expand">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.payload)\hesh-ups.exe" />
    </Feature>

    <Feature Id="StartMenuShortcut" Title="Start Menu shortcut" Description="Add hesh-ups to the Start Menu" Level="1" AllowAbsent="yes" AllowAdvertise="no">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut
          Id="AppShortcut"
          Name="hesh-ups"
          Description="hesh-ups"
          Target="[INSTALLFOLDER]hesh-ups.exe"
          WorkingDirectory="INSTALLFOLDER"
          Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\TEW020\hesh-ups" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\license.rtf" />
  </Package>
</Wix>
